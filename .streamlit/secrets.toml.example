# Optional. The app reads the Groq key from the sidebar by default.
#  - Local:  copy this to .streamlit/secrets.toml and fill in your key.
#  - Cloud:  paste the line below into App -> Settings -> Secrets.
# Leave unset for a public demo so each visitor uses their own free Groq key.

GROQ_API_KEY = "gsk_your_key_here"
